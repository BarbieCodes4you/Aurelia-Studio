# Settings for running Aurelia Studios on your own computer (copy to .env).
# Don't paste this file into Railway: its values are for local testing (APP_ENV=development,
# BASE_URL=http://127.0.0.1:8040). For Railway, follow DEPLOY-RAILWAY.md.
# Copy to .env and fill in. Real environment variables override this file.
APP_ENV=development                 # production turns off debug output
BASE_URL=http://127.0.0.1:8040      # public address, used in emails and payment callbacks (on Railway: Railway's domain until you set yours)
# Live: BASE_URL=https://aureliastudios.co.za  (www. and the Railway address then redirect there; CANONICAL_REDIRECT=0 turns that off)
SECRET_KEY=                         # optional: if empty, a random key is created once and kept in the data folder
# TRUST_PROXY=0                     # 1 behind a reverse proxy you control; on by itself on Railway
# AURELIA_DATA_DIR=./data           # database, uploads, email outbox
# DATABASE_PATH=./data/aurelia.sqlite3

BRAND_NAME=Aurelia Studios
SUPPORT_EMAIL=invitesaurelia@gmail.com
COMPANY_ADDRESS=Johannesburg, South Africa
INFORMATION_OFFICER_EMAIL=          # POPIA information officer
WHATSAPP_NUMBER=                    # support WhatsApp, e.g. 082 123 4567; shows a chat button on every page
SOCIAL_INSTAGRAM=                   # full links; each shows in the footer only when set
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=
VAT_NUMBER=                         # shown on tax invoices

# Email: outbox (dev, writes files to data/outbox), resend, or smtp. On Railway use resend (SMTP is blocked on Hobby).
EMAIL_PROVIDER=outbox
EMAIL_FROM=Aurelia Studios <no-reply@aurelia.example>   # live: Aurelia Studios <invites@aureliastudios.co.za>
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1

# Payments: sandbox (built-in test checkout, no money moves) or payfast
PAYMENT_GATEWAY=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=1                   # 0 for live payments
PAYFAST_CHECK_IP=1
ALLOW_SANDBOX_PAYMENTS=0            # production refuses the test checkout unless 1 (staging/demo only)

# First admin (created on start if missing), or use: python3 run.py --create-admin you@example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=

SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_SECONDS=300
# SECURE_COOKIES=1                  # leave unset: it switches on by itself when BASE_URL is https

# Hosting
TRUST_PROXY=0                       # 1 only behind a reverse proxy you control (Caddy, Nginx, Render, Railway, Fly)
SCHEDULER_IN_WSGI=0                 # wsgi.py only; prefer cron: python3 run.py --jobs-once
